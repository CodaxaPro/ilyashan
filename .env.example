# Ilyashan – Production Environment Variables
# Kopieren nach .env.local für lokale Entwicklung (nicht committen)

# ── E-Mail (Pflicht für Formulare) ──
RESEND_API_KEY=re_xxxxxxxx
CONTACT_EMAIL=info@ilyashan.de
FROM_EMAIL=Ilyashan Fensterreinigung <info@ilyashan.de>

# ── Admin Panel /admin ──
ADMIN_PASSWORD=ihr-sicheres-passwort

# ── Upstash Redis (Vercel Integration) – Leads + unbekannte Fragen ──
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxx

# ── First-party Analytics (Supabase PostgreSQL) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Optional: IP hashing salt (defaults to ADMIN_PASSWORD)
ANALYTICS_IP_SALT=random-secret-salt

# ── Website-Assistent (lokal testen) ──
# true = Assistent sichtbar (ohne Admin-Schalter). Production: über /admin → Einstellungen.
CONCIERGE_ENABLED=false

# ── Google Ads Conversion (Gate-0 — zorunlu ölçüm) ──
# Ads → Ziele/Conversions → her aksiyon için Event snippet → send_to satırını yapıştır
# Birincil (teklif formu / Angebot WhatsApp gönder)
NEXT_PUBLIC_GOOGLE_ADS_REQUEST_QUOTE_SEND_TO=AW-18191480247/xxxxxxxx
# İkincil (floating WhatsApp tıklama)
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=AW-18191480247/yyyyyyyy
# İkincil (sitede tel: tıklama — Call asset ≥60sn ayrı)
NEXT_PUBLIC_GOOGLE_ADS_PHONE_SEND_TO=AW-18191480247/zzzzzzzz

# --- Google Ads API (control scripts) — use .env.local, never commit ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_PROJECT_ID=
